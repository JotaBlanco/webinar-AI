# Everything under data/ is large + replicated from KB003 — gitignore wholesale.
# Keep only the top-level data/ folder structure (committed via .gitkeep if needed)
# so consumers know it exists.
data/*
!data/.gitkeep
webinar-angle-*/**/out/**/*.csv
webinar-angle-*/**/out/**/*.parquet
webinar-angle-*/**/out/**/*.npz
module-*/**/out/**/*.csv
module-*/**/out/**/*.parquet
module-*/**/out/**/*.npz
deprecated/**/out/**/*.csv
deprecated/**/out/**/*.parquet
deprecated/**/out/**/*.npz
# Large local webinar recordings + exported module videos (multi-GB) — never commit.
# Only webinar-offline/site/ (the public microsite) is tracked.
webinar-offline/recording/
webinar-offline/video splits/
.DS_Store
__pycache__/
*.pyc
*.pkl
.venv/
.claude/main-session-unlock
.claude/blocked-attempts.log
# Transient per-run launch state — machine-specific, not meaningful in the repo.
.claude/current-launch.txt
cohort-runs/.launch-config.json
