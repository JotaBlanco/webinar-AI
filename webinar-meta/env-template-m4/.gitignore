# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# RPI phase artefacts — locked, generated per-run
rpi/artifacts/RESEARCH.md
rpi/artifacts/PLAN.md
# But keep the artifacts/ dir itself so run-research.sh has somewhere to write.
!rpi/artifacts/.gitkeep

# launch-rungs per-session workdirs
launch-rungs/_sessions/

# physics-catalog fit outputs — coeffs.default.json is committed (textbook
# priors), but coeffs.json and fit_diagnostics.json are per-run outputs that
# would shadow the defaults if committed.
physics-catalog/*/coeffs.json
physics-catalog/*/fit_diagnostics.json

# Agent-built candidates — populated by `iterate` during a run, not part of
# the template baseline. If the project wants to ship a frozen candidate,
# add it as an explicit allow rule.
models/*/predict.py
models/*/notes.md
models/*/coeffs.json
models/*/fit_diagnostics.json
models/*/assessment.md
models/*/_local_score.txt

# final-model/ contents — per-run shipment, not the template
final-model/predict.py
final-model/coeffs.json
final-model/manifest.json
final-model/REPORT.md

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local test outputs
_test_output/
*.tmp
